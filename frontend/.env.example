#
# LOCAL (desarrollo):
VITE_BITAL_API_BASE_URL=http://localhost:8080/api/v1
VITE_BITAL_API_HEALTH_URL=http://localhost:8080/health
#
# DESPLEGADO (producción / staging):
# VITE_BITAL_API_BASE_URL=http://186.190.254.230:8080/api/v1
# VITE_BITAL_API_HEALTH_URL=http://186.190.254.230:8080/health
#
# =============================================================================
# Módulos
# =============================================================================
#
# Dietas-cocina: true = solo datos del API (sin mocks). false = modo demo offline.
VITE_DIETAS_COCINA_API=true
#
# Encuestas: true = módulo visible y accesible. false = inhabilitado (código conservado).
VITE_ENCUESTAS_ENABLED=false
VITE_ENCUESTAS_API=false
#
# Versión del aplicativo
VITE_APP_VERSION=1.0.0
