# =============================================================================
# API Bital (backend Bital.ApiNegocio)
# =============================================================================
#
# Copiar según entorno:
#   Desarrollo  → .env.local       (usa proxy Vite para cookies JWT)
#   Producción  → .env.production  (pnpm build)
#
# LOCAL con cookies JWT (recomendado — usa el proxy de Vite):
# VITE_BITAL_API_BASE_URL=/api/v1
# VITE_BITAL_API_HEALTH_URL=/health
# VITE_DEV_API_PROXY_TARGET=http://localhost:8080
#
# PRODUCCIÓN (servidor desplegado):
# VITE_BITAL_API_BASE_URL=http://186.190.254.230:8080/api/v1
# VITE_BITAL_API_HEALTH_URL=http://186.190.254.230:8080/health
#
# Si el frontend va en Hostinger con HTTPS, actualiza la URL del API a HTTPS
# y añade el dominio del frontend en Cors:AllowedOrigins del backend.
#
# =============================================================================
# Módulos
# =============================================================================
#
# Dietas-cocina: true = solo datos del API (sin mocks). false = modo demo offline.
VITE_DIETAS_COCINA_API=true
#
# Encuestas: true = módulo visible y accesible. false = inhabilitado (código conservado).
VITE_ENCUESTAS_ENABLED=false
VITE_ENCUESTAS_API=false
#
# Versión del aplicativo
VITE_APP_VERSION=1.0.0
