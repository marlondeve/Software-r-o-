# =============================================================================
# API RioSoft (backend Bital.ApiNegocio)
# =============================================================================
#
# ENTORNOS:
#   Desarrollo local  → .env.local          (pnpm dev, proxy Vite)
#   Producción IIS    → .env.production     (pnpm build:iis)
#
# LOCAL con cookies JWT (recomendado — usa el proxy de Vite):
# VITE_BITAL_API_BASE_URL=/api/v1
# VITE_BITAL_API_HEALTH_URL=/health
# VITE_DEV_API_PROXY_TARGET=http://localhost:8080
#
# PRODUCCIÓN IIS — copiar .env.production.example → .env.production
#   URLs relativas /api/v1 + proxy en public/web.config → localhost:8081
#   Guía: backend/DEPLOYMENT-IIS-GUIDE.md
#
# =============================================================================
# Módulos
# =============================================================================
VITE_DIETAS_COCINA_API=true
VITE_ENCUESTAS_ENABLED=false
VITE_ENCUESTAS_API=false
VITE_APP_VERSION=1.2.1
