# =============================================================================
# API Bital (backend Bital.ApiNegocio)
# =============================================================================
#
# ENTORNOS:
#   Desarrollo local  → .env.local          (pnpm dev, proxy Vite)
#   IIS (clínica)     → .env.production      (pnpm build / pnpm build:iis)
#   Hostinger         → .env.hostinger       (pnpm build:hostinger)
#
# LOCAL con cookies JWT (recomendado — usa el proxy de Vite):
# VITE_BITAL_API_BASE_URL=/api/v1
# VITE_BITAL_API_HEALTH_URL=/health
# VITE_DEV_API_PROXY_TARGET=http://localhost:8080
#
# IIS / API directo (defina la URL en .env.production; no use IPs en el repo):
# VITE_BITAL_API_BASE_URL=https://api.ejemplo.clinica/api/v1
# VITE_BITAL_API_HEALTH_URL=https://api.ejemplo.clinica/health
#
# HOSTINGER — https://tu-subdominio.ejemplo.com
#   pnpm build:hostinger  →  URLs relativas /api/v1 + proxy en .htaccess
#   HOSTINGER_API_PROXY=http://host:puerto   (solo build; no va al bundle JS)
#   Subir frontend/dist/ a la carpeta del subdominio
#   Backend: CORS y Jwt:CrossOriginCookies en appsettings.Production.json
#
# =============================================================================
# Módulos
# =============================================================================
VITE_DIETAS_COCINA_API=true
VITE_ENCUESTAS_ENABLED=false
VITE_ENCUESTAS_API=false
VITE_APP_VERSION=1.0.0
