{
  "name": "bital",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24.18.0",
    "pnpm": ">=11.15.1"
  },
  "scripts": {
    "dev": "pnpm --filter frontend dev",
    "dev:clean": "pnpm --filter frontend dev:clean",
    "dev:front": "pnpm --filter frontend dev",
    "dev:back": "pnpm --filter backend dev",
    "build": "pnpm --filter frontend build:iis",
    "build:front": "pnpm --filter frontend build:iis",
    "build:iis": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-iis.ps1",
    "build:iis:apinegocio": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-iis.ps1 -Target apinegocio",
    "build:iis:frontend": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-iis.ps1 -Target frontend",
    "build:back": "pnpm --filter backend build",
    "lint": "pnpm --filter frontend lint",
    "preview": "pnpm --filter frontend preview"
  }
}
